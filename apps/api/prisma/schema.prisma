generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum test_result {
  pass
  fail
  not_executed
}

enum bug_severity {
  minor
  major
  critical
}

enum bug_status {
  open
  fixed
  verified
  closed
}

enum test_run_mode {
  full_check
  cross_check
  recheck
}

enum artifact_source {
  scan
  user_note
  cross_check
}

model test_cases {
  test_case_number  String
  test_page_area    String
  test_scenario     String
  test_step_number  Int
  step_details      String
  expected_output   String
  test_data         String?
  result            test_result
  bug_id            String?
  screenshot        String?
  qa_comments       String?
  bug_severity      bug_severity?
  bug_status        bug_status?
  // Not display columns (PROJECT_SPEC.md Section 5): generation link,
  // traceability and the machine-readable step for the execution engine.
  test_run_id       String?
  checklist_item_id String?
  source            artifact_source?
  step_action       Json?
  run_results       test_run_results[]
  test_run          test_runs?         @relation(fields: [test_run_id], references: [id], onDelete: SetNull)
  checklist_item    checklist_items?   @relation(fields: [checklist_item_id], references: [id], onDelete: SetNull)

  @@id([test_case_number, test_step_number])
  @@index([test_run_id])
}

model test_runs {
  id                     String             @id @default(cuid())
  mode                   test_run_mode
  url                    String
  timestamp              DateTime           @default(now())
  status                 String
  screenshot_path        String?
  page_json_path         String?
  error                  String?
  // Set when the user approves the test case sheet; cleared by any edit or
  // regeneration. Step 10 only runs sheets with this set.
  test_cases_approved_at DateTime?
  results                test_run_results[]
  checklist_items        checklist_items[]
  edit_requests          edit_requests[]
  test_cases             test_cases[]
}

model test_run_results {
  id                    String        @id @default(cuid())
  test_run_id           String
  test_case_number      String
  test_step_number      Int
  result                test_result
  ai_proposed_result    test_result?
  user_confirmed_result test_result?
  bug_id                String?
  screenshot            String?
  qa_comments           String?
  bug_severity          bug_severity?
  bug_status            bug_status?
  test_run              test_runs     @relation(fields: [test_run_id], references: [id])
  test_case             test_cases    @relation(fields: [test_case_number, test_step_number], references: [test_case_number, test_step_number])

  @@unique([test_run_id, test_case_number, test_step_number])
}

model checklist_items {
  id                String          @id @default(cuid())
  test_run_id       String
  title             String
  description       String
  related_selectors Json
  approved          Boolean         @default(false)
  rejected          Boolean         @default(false)
  added_by_user     Boolean         @default(false)
  source            artifact_source
  test_run          test_runs       @relation(fields: [test_run_id], references: [id])
  test_cases        test_cases[]
}

model edit_requests {
  id            String          @id @default(cuid())
  test_run_id   String
  instruction   String
  proposed_diff Json
  source        artifact_source
  created_at    DateTime        @default(now())
  // Instruction-based edits (step 9b): proposed | applied | discarded | empty
  status        String          @default("proposed")
  /// Validated operations, applied as-is on confirm.
  operations    Json?
  warnings      Json?
  /// Hash of the sheet the proposal was made against; apply refuses if it changed.
  sheet_version String?
  /// Claude model and token usage, for the audit trail and cost.
  model         String?
  usage         Json?
  decided_at    DateTime?
  test_run      test_runs       @relation(fields: [test_run_id], references: [id])

  @@index([test_run_id, created_at])
}
